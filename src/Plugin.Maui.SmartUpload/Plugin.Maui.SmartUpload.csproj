<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0;net10.0-android;net10.0-ios</TargetFrameworks>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);CS1591</NoWarn>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>

		<RootNamespace>Plugin.Maui.SmartUpload</RootNamespace>
		<AssemblyName>Plugin.Maui.SmartUpload</AssemblyName>
		<PackageId>Plugin.Maui.SmartUpload</PackageId>
		<Title>.NET MAUI SmartUpload — chunked resumable uploads</Title>
		<Description>Resumable, chunked HTTP uploads for .NET MAUI on Android and iOS. Pause/resume, automatic retry with backoff, and session persistence across process restarts. Includes Content-Range and tus.io protocols.</Description>
		<PackageTags>dotnet-maui;maui;maui-plugin;maui-utilities;cross-platform;android;ios;nuget;mauiessentials;upload;resumable;chunked;tus;tus-io;retry;pause;resume;http;content-range</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageProjectUrl>https://github.com/nuvyntralabs/Plugin.Maui.SmartUpload</PackageProjectUrl>
		<RepositoryUrl>https://github.com/nuvyntralabs/Plugin.Maui.SmartUpload</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<Authors>MauiEssentials</Authors>
		<Company>MauiEssentials</Company>
		<Copyright>Copyright © MauiEssentials</Copyright>
		<Version>1.0.4</Version>
		<PackageOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts</PackageOutputPath>
		<IsPackable>true</IsPackable>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<PackageReleaseNotes>Repository moved to nuvyntralabs. Package project and repository URLs updated.</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Plugin.Maui.SmartUpload.Tests" />
	</ItemGroup>

</Project>
